# The admin UI runs on mock data unless this is set to "http".
PUBLIC_TIMETOWER_MODE=mock

# Timetower has no configured-user listing endpoint. The carousel uses this
# comma-separated fallback (and unions in users seen in /api/v1/enforcers).
PUBLIC_TIMETOWER_USERS=dani,alex,sam,taylor

# HTTP mode: leave empty to call the same-origin proxy at /api/v1. Set an
# absolute origin only for direct development access to Timetower.
PUBLIC_TIMETOWER_API_URL=

# Optional and NOT recommended in production: this value is bundled into the
# browser. Use the private proxy variables below instead.
PUBLIC_TIMETOWER_API_TOKEN=

# Server-side proxy configuration. These values never reach the browser.
TIMETOWER_API_URL=https://timetower.ogreg.org
TIMETOWER_API_TOKEN=replace-with-TIMELORD_KEY
