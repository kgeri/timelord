{
	"name": "timetower-admin",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"generate:api": "openapi-typescript ../docs/openapi.yaml -o src/lib/api/schema.d.ts",
		"dev": "npm run generate:api && vite dev",
		"mock": "npm run generate:api && vite dev --mode mock",
		"build": "npm run generate:api && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run generate:api && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run generate:api && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
